# 위드플러스 세금계산기 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 Git에 올라가지 않습니다(.gitignore). 토큰을 카톡·메일 본문에 그대로 남기지 마세요.

# local = 내 PC 전용(Claude Desktop/Claude Code), public = 외부 공개(HTTP + 토큰)
WITHPLUS_MODE=local

# public 모드에서 받을 도메인(Cloudflare Tunnel에 연결한 주소). 여러 개면 쉼표로.
WITHPLUS_PUBLIC_HOSTS=mcp.withplustax.com

# 서버 포트(Cloudflare 설정의 service 주소와 같아야 함)
WITHPLUS_PORT=8001

# 접속 토큰 — "이름:토큰" 을 쉼표로 이어서. 토큰은 deploy\new_token.bat 으로 만든다(24자 이상).
# 예: WITHPLUS_TOKENS=조덕희:xxxxxxxx,홍길동세무사:yyyyyyyy
WITHPLUS_TOKENS=

# 결과마다 붙는 안내 문구. 비워 두면(WITHPLUS_FOOTER=) 끔. 줄을 지우면 기본 문구 사용.
# WITHPLUS_FOOTER=본 결과는 세무법인 위드플러스 세금계산기의 검토 보조자료입니다. 문의 02-438-7001

# 사용 로그 폴더(누가 어떤 도구를 불렀는지만, 입력값은 저장 안 함)
WITHPLUS_LOG_DIR=logs

# (선택) 원본 기능용 키 — 없어도 계산 도구는 모두 동작
# LAW_OC=법제처 OC
# UPSTAGE_API_KEY=
